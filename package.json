{
  "name": "tocky-code",
  "displayName": "Tocky Code",
  "description": "Multi-language VS Code security plugin for vulnerability detection, AI remediation, and independent verification",
  "version": "0.1.0",
  "publisher": "tocky",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tocky/tocky-code"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeguard-explorer",
          "title": "Tocky Code",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "codeguard-explorer": [
        {
          "id": "codeguard.findingsView",
          "name": "Security Findings",
          "type": "tree"
        },
        {
          "id": "codeguard.statusView",
          "name": "Verification & Metrics",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codeguard.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Tocky Code",
        "icon": "$(search)"
      },
      {
        "command": "codeguard.scanFile",
        "title": "Scan Current File",
        "category": "Tocky Code",
        "icon": "$(file-code)"
      },
      {
        "command": "codeguard.explainFinding",
        "title": "Explain Finding",
        "category": "Tocky Code"
      },
      {
        "command": "codeguard.proposeFix",
        "title": "Propose Fix",
        "category": "Tocky Code",
        "icon": "$(tools)"
      },
      {
        "command": "codeguard.verifyPatch",
        "title": "Verify Patch",
        "category": "Tocky Code",
        "icon": "$(shield)"
      },
      {
        "command": "codeguard.openReport",
        "title": "Open Latest Report",
        "category": "Tocky Code"
      },
      {
        "command": "codeguard.showMetrics",
        "title": "Show Metrics",
        "category": "Tocky Code"
      },
      {
        "command": "codeguard.applyApprovedPatch",
        "title": "Approve and Apply Patch",
        "category": "Tocky Code",
        "icon": "$(check)"
      },
      {
        "command": "codeguard.rejectPatch",
        "title": "Reject Proposed Patch",
        "category": "Tocky Code",
        "icon": "$(close)"
      },
      {
        "command": "codeguard.setApiKey",
        "title": "Set LLM API Key (Quick)",
        "category": "Tocky Code",
        "icon": "$(key)"
      },
      {
        "command": "codeguard.configureApiKey",
        "title": "Add / Update API Key",
        "category": "Tocky Code",
        "icon": "$(key)"
      },
      {
        "command": "codeguard.addApiKey",
        "title": "Add API Key",
        "category": "Tocky Code",
        "icon": "$(key)"
      },
      {
        "command": "codeguard.onApiKeyUpdated",
        "title": "Fix Vulnerabilities with Updated API Key",
        "category": "Tocky Code",
        "icon": "$(zap)"
      },
      {
        "command": "codeguard.autoFixWorkspace",
        "title": "Auto Scan, Fix and Verify with Copilot",
        "category": "Tocky Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeguard.scanWorkspace",
          "when": "view == codeguard.findingsView",
          "group": "navigation@1"
        },
        {
          "command": "codeguard.scanFile",
          "when": "view == codeguard.findingsView",
          "group": "navigation@2"
        },
        {
          "command": "codeguard.configureApiKey",
          "when": "view == codeguard.findingsView || view == codeguard.statusView",
          "group": "navigation@3"
        },
        {
          "command": "codeguard.addApiKey",
          "when": "view == codeguard.statusView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "codeguard.proposeFix",
          "when": "view == codeguard.findingsView && viewItem == finding",
          "group": "inline"
        },
        {
          "command": "codeguard.explainFinding",
          "when": "view == codeguard.findingsView && viewItem == finding",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Tocky Code",
      "properties": {
        "codeguard.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable running the CodeGuard backend"
        },
        "codeguard.llmProvider": {
          "type": "string",
          "enum": [
            "copilot",
            "codeguard-model",
            "gemini",
            "openai",
            "custom",
            "mock"
          ],
          "default": "copilot",
          "description": "LLM used for fix proposals: 'copilot' (GitHub Copilot - no API key needed), 'gemini' (Google Gemini API), 'openai' (OpenAI API), 'codeguard-model' (built-in specialized fast engine), or 'custom' (Ollama/private server)"
        },
        "codeguard.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for your chosen cloud LLM provider (e.g. Google Gemini API Key or OpenAI API Key)"
        },
        "codeguard.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "LLM model identifier to use (e.g. 'gemini-2.5-flash', 'gemini-1.5-flash', 'gemini-1.5-pro', or 'gpt-4o-mini')"
        },
        "codeguard.customLlmEndpoint": {
          "type": "string",
          "default": "http://localhost:11434/api/generate",
          "description": "HTTP endpoint URL for custom/local security LLM (e.g. Ollama or private server)"
        },
        "codeguard.useDocker": {
          "type": "boolean",
          "default": false,
          "description": "Use Docker container for verification test execution"
        },
        "codeguard.verificationTimeout": {
          "type": "number",
          "default": 30,
          "description": "Timeout in seconds for verification executions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.3.3"
  }
}
