# CodeGuard AI Configuration Example
# Copy this file to .env and configure for your local environment.

# LLM Provider Configuration
# Supported providers: gemini, openai, anthropic, mock
CODEGUARD_LLM_PROVIDER=mock
CODEGUARD_LLM_MODEL=default-model

# API Keys (leave blank if using mock provider or local models)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Scanner Paths (CodeGuard will auto-detect from PATH if not specified)
# SEMGREP_PATH=semgrep
# BANDIT_PATH=bandit
# GITLEAKS_PATH=gitleaks
# ESLINT_PATH=eslint

# Verification Sandbox Configuration
# Set to true to use Docker container for running verification tests
CODEGUARD_USE_DOCKER=false
CODEGUARD_DOCKER_IMAGE=python:3.11-slim
CODEGUARD_VERIFICATION_TIMEOUT=60

# Telemetry / Local Storage
CODEGUARD_DB_PATH=.codeguard/history.db
